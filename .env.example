# Salin file ini menjadi .env (lokal) dan isi dengan nilai asli.
# Untuk Vercel, isi variabel yang sama di Project Settings > Environment Variables.

DATABASE_URL="postgresql://user:password@localhost:5432/waris_ai"
NEXT_PUBLIC_APP_URL="https://waris-ai.com"

# WAJIB diisi: kunci rahasia untuk menandatangani sesi login (JWT).
# Isi dengan string acak yang panjang & rahasia, JANGAN pakai contoh di bawah ini.
# Cara generate cepat di PowerShell: [System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Gunakan test key saat development, ganti dengan live key hanya di environment production.
STRIPE_SECRET_KEY="sk_test_..."
MIDTRANS_SERVER_KEY="Mid-server-..."
